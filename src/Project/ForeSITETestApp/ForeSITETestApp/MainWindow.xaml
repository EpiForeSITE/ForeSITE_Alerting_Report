<Window x:Class="ForeSITETestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForeSITE — Public Health Report Builder"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="/ForeSITELogo.png"
        Background="#11171C"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!--
    THESIS: ForeSITE is a live surveillance signal board wrapped around a readable report page; it refuses the generic light-card dashboard.
    OWN-WORLD: Graphite and steel chrome, fixed-cell status bands, condensed labels, cool-white document canvas, amber action, red alert.
    STORY: Configure data, period, model, visualization, and delivery in one place; run once; review the finished report without changing modes.
    FIRST VIEWPORT: Compact command frame around a dominant builder with the report canvas at center and Run Report at upper right.
    FORM: Approved A+B hybrid; Surveillance Signal Board; seed b7c99bf3.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Grid>
        <Border Background="#11171C" BorderBrush="#3A444C" BorderThickness="1">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
