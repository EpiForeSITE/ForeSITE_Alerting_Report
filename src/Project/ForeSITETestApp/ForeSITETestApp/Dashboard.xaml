<UserControl x:Class="ForeSITETestApp.Dashboard"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ForeSITETestApp"
            mc:Ignorable="d" 
            d:DesignHeight="900" d:DesignWidth="1440"
            Background="#11171C" FontFamily="Segoe UI">
    <!--
    THESIS: A saved surveillance report is an inspectable operating record, not a generic dashboard card wall.
    OWN-WORLD: Graphite instrument rails, steel rules, condensed telemetry, scarce amber signals, and cool-white report paper.
    STORY: Choose a definition, verify its provenance and schedule, inspect a completed run, then refresh or open its PDF.
    FIRST VIEWPORT: Saved-report rail left, dominant report sheet center, provenance/actions/history inspector right; Run Now is primary.
    FORM: Three-rail surveillance signal board, chosen option 2, seed key challenger-split-flap.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.CheckBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CFD7DD"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#263039"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter Property="Background" Value="#27333B"/>
                                    <Setter Property="Foreground" Value="#F2A900"/>
                                    <Setter Property="BorderBrush" Value="#F2A900"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFD36A"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F2A900"/>
                <Setter Property="Foreground" Value="#11171C"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFC13A"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#3A444C"/>
                                    <Setter Property="Foreground" Value="#9EABB4"/>
                                    <Setter Property="Opacity" Value="0.72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SignalLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift Condensed"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#9EABB4"/>
            </Style>
            <Style x:Key="PanelHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F1F4F6"/>
            </Style>
            <Style x:Key="InspectorComboStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#17212A"/>
                <Setter Property="Background" Value="#F2F4F5"/>
                <Setter Property="BorderBrush" Value="#53616B"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>
            <Style x:Key="InspectorTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="#E4E9EC"/>
                <Setter Property="Background" Value="#202A31"/>
                <Setter Property="BorderBrush" Value="#53616B"/>
                <Setter Property="CaretBrush" Value="#F2A900"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>
            <Style x:Key="InspectorDateStyle" TargetType="DatePicker">
                <Setter Property="Foreground" Value="#17212A"/>
                <Setter Property="Background" Value="#F2F4F5"/>
                <Setter Property="BorderBrush" Value="#53616B"/>
            </Style>
            <Style x:Key="InspectorButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E4E9EC"/>
                <Setter Property="Background" Value="#26323A"/>
                <Setter Property="BorderBrush" Value="#596873"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="DataSourceFieldStyle" TargetType="TextBox" BasedOn="{StaticResource InspectorTextBoxStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="DataSourceFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SignalLabelStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="DataSourceColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#27333B"/>
                <Setter Property="Foreground" Value="#E4E9EC"/>
                <Setter Property="BorderBrush" Value="#3A444C"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="FontFamily" Value="Bahnschrift Condensed"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SchedulerRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#E4E9EC"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#3A444C"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#27333B"/>
                        <Setter Property="Foreground" Value="#F1F4F6"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#FFD36A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SchedulerCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#3A444C"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="Padding" Value="10,7"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#27333B"/>
                        <Setter Property="Foreground" Value="#F1F4F6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="#CFD7DD"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#3A444C"/>
                <Setter Property="Padding" Value="18,12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#202A31"/>
                                    <Setter Property="Foreground" Value="#F1F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#27333B"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#F2A900"/>
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="Foreground" Value="#F2A900"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFD36A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Defining grid layout: 1 column for sidebar, 1 for main content -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#151D23" Grid.Column="0" BorderBrush="#3A444C" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="12,16,12,12">

                <!-- Logo or Title -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,22">
                    <TextBlock Text="ForeSITE" Foreground="#F1F4F6" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="PUBLIC HEALTH INTELLIGENCE" Style="{StaticResource SignalLabelStyle}" Foreground="#F2A900"/>
                </StackPanel>

                <StackPanel>

                <!-- Navigation Menu -->
                <Button x:Name="ReportButton"
                Content="Reports"
                Style="{StaticResource NavButtonStyle}"
                Tag="Active"
                Margin="5"
                Click="ReportButton_Click"/>

                <Button x:Name="SchedulerButton"
                Content="Schedules"
                Style="{StaticResource NavButtonStyle}"
                Margin="5"
                Click="SchedulerButton_Click"/>

                <Button x:Name="DataSourceButton"
                Content="Data Sources"
                Style="{StaticResource NavButtonStyle}"
                Margin="5"
                Click="DataSourceButton_Click"/>

                <Button x:Name="ModelButton"
                Content="Algorithms"
                Style="{StaticResource NavButtonStyle}"
                Margin="5"
                Click="ModelButton_Click"/>

                <Button x:Name="SettingButton"
                Content="Settings"
                Style="{StaticResource NavButtonStyle}"
                Margin="5"
                Click="SetupButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="#151D23" Grid.Row="0" BorderBrush="#3A444C" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="HeaderTitle" Text="Report Library" FontSize="18" FontWeight="SemiBold" Foreground="#F1F4F6" VerticalAlignment="Center" Margin="20,0,0,0" DockPanel.Dock="Left"/>
                    <StackPanel x:Name="ReportModeButtons" Orientation="Horizontal" DockPanel.Dock="Left" Margin="22,10,0,10">
                        <Button x:Name="LibraryModeButton" Content="REPORT LIBRARY" Padding="12,6" Foreground="#F2A900" Background="#27333B" BorderBrush="#F2A900" Click="LibraryModeButton_Click"/>
                        <Button x:Name="BuilderModeButton" Content="REPORT BUILDER" Padding="12,6" Margin="6,0,0,0" Foreground="#CFD7DD" Background="Transparent" BorderBrush="#596873" Click="BuilderModeButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"  Margin="10">
                        <Button x:Name="AddNotebookButton" Content="Analysis Notebook" Foreground="#CFD7DD" Background="Transparent" BorderBrush="#4B5963" Margin="0,0,8,0" Padding="12,7" Click="AddNotebookButton_Click" />
                        <Button x:Name="AIButton" Content="AI Assistant" Foreground="#CFD7DD" Background="Transparent" BorderBrush="#4B5963" Padding="12,7" Click="AIButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area with Switchable Grids -->
            <Grid x:Name="btnAddModule" Grid.Row="1" Margin="0" Background="#20282E">
                <!-- Report Library / read-only Report View -->
                <Grid x:Name="ReportLibraryGrid" Visibility="Visible" Background="#20282E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="278"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="326"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#151D23" BorderBrush="#3A444C" BorderThickness="0,0,1,0">
                        <Grid Margin="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Saved Reports" Style="{StaticResource PanelHeadingStyle}" VerticalAlignment="Center"/>
                                <Button Content="NEW REPORT" HorizontalAlignment="Right" Style="{StaticResource InspectorButtonStyle}" Padding="10,6" Click="NewReportButton_Click"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,14,0,10">
                                <TextBlock Text="SEARCH REPORTS" Style="{StaticResource SignalLabelStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="ReportSearchBox" Padding="9,7" Background="#202A31" Foreground="#E4E9EC" BorderBrush="#53616B" ToolTip="Type a report name" TextChanged="ReportSearchBox_TextChanged"/>
                            </StackPanel>
                            <ListBox x:Name="ReportLibraryList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#CFD7DD" HorizontalContentAlignment="Stretch" SelectionChanged="ReportLibraryList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="0,0,0,5" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1B242B"/>
                                                    <Setter Property="BorderBrush" Value="#3A444C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Background" Value="#27333B"/>
                                                            <Setter Property="BorderBrush" Value="#F2A900"/>
                                                            <Setter Property="BorderThickness" Value="3,1,1,1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FFD36A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="#F1F4F6" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastRunStatus}" Foreground="#F2A900" FontSize="11" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding LastGeneratedAt, StringFormat='{}{0:g}', TargetNullValue='No completed runs'}" Foreground="#9EABB4" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="16" Background="#2B353C" BorderBrush="#46535D" BorderThickness="1" CornerRadius="2">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Background="#182127" LastChildFill="False">
                                <TextBlock x:Name="ReportViewTitle" Text="REPORT VIEW" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" VerticalAlignment="Center" Margin="14,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="ReportViewStatus" Text="SELECT A REPORT" Style="{StaticResource SignalLabelStyle}" Foreground="#9EABB4" VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
                                <Border Width="760" MinHeight="700" Background="#F7F8F6" BorderBrush="#B9C1C6" BorderThickness="1" Padding="36" HorizontalAlignment="Center">
                                    <StackPanel x:Name="ReportViewContent">
                                        <TextBlock Text="Choose a saved report" Foreground="#5D6A73" FontSize="22" FontWeight="SemiBold" Margin="8,50,8,10"/>
                                        <TextBlock Text="Its latest completed snapshot will appear here. You can also run it now to refresh the data." Foreground="#677781" FontSize="14" TextWrapping="Wrap" Margin="8,0"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#151D23" BorderBrush="#3A444C" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,16" TextElement.Foreground="#CFD7DD">
                                <TextBlock x:Name="ReportDetailsName" Text="No report selected" Style="{StaticResource PanelHeadingStyle}" Foreground="#F2A900" Margin="0,0,0,18" TextWrapping="Wrap"/>

                                <TextBlock Text="DATA SOURCE" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsDataSource" Text="Not available" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <TextBlock Text="ALGORITHM" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsAlgorithm" Text="Not available" Margin="0,4,0,12"/>
                                <TextBlock Text="PERIOD" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsPeriod" Text="Not available" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <TextBlock Text="THRESHOLD" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsThreshold" Text="Not available" Margin="0,4,0,12"/>
                                <TextBlock Text="DEFINITION UPDATED" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsDefinition" Text="Not available" Margin="0,4,0,16"/>

                                <TextBlock Text="SCHEDULE" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsSchedule" Text="Not scheduled" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <TextBlock Text="DELIVERY" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsDelivery" Text="None" Margin="0,4,0,12"/>
                                <TextBlock Text="SELECTED RUN" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsGenerated" Text="Never" Margin="0,4,0,12"/>
                                <TextBlock Text="DATA AS OF" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportDetailsDataAsOf" Text="Not available" Margin="0,4,0,18"/>

                                <Button x:Name="RunSavedReportButton" Content="RUN NOW" Style="{StaticResource HeaderButtonStyle}" Padding="14,9" Click="RunSavedReportButton_Click" IsEnabled="False"/>
                                <UniformGrid Columns="2" Margin="0,8,0,18">
                                    <Button x:Name="OpenLatestPdfButton" Content="OPEN PDF" Style="{StaticResource InspectorButtonStyle}" Padding="8" Margin="0,0,4,0" Click="OpenLatestPdfButton_Click" IsEnabled="False"/>
                                    <Button x:Name="EditSavedReportButton" Content="EDIT" Style="{StaticResource InspectorButtonStyle}" Padding="8" Margin="4,0,0,0" Click="EditSavedReportButton_Click" IsEnabled="False"/>
                                </UniformGrid>

                                <Separator Background="#3A444C" Margin="0,0,0,16"/>
                                <TextBlock Text="RUN HISTORY" Style="{StaticResource SignalLabelStyle}"/>
                                <TextBlock x:Name="ReportRunHistoryEmpty" Text="No runs yet. Choose Run Now to create the first snapshot." Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <ListBox x:Name="ReportRunHistoryList" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="#CFD7DD" HorizontalContentAlignment="Stretch" SelectionChanged="ReportRunHistoryList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#3A444C" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Status}" Foreground="#F1F4F6" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CompletedAt, StringFormat='{}{0:g}'}" Foreground="#9EABB4" FontSize="11"/>
                                                        <TextBlock Text="{Binding SourceLabel}" Foreground="#9EABB4" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding IsAbnormal, StringFormat='Abnormal: {0}'}" Foreground="#9EABB4" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Scheduler Grid -->
                <Grid x:Name="SchedulerGrid" Visibility="Collapsed">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="286"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Windows task service rail -->
                        <Border Grid.Column="0" Background="#182127" BorderBrush="#3A444C" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scheduler service" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                    <TextBlock Text="Controls when ForeSITE checks scheduled reports on this computer."
                                               Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Border Grid.Row="1" Margin="0,20,0,0" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="SERVICE STATUS" Style="{StaticResource SignalLabelStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Ellipse x:Name="SchedulerServiceStatusDot" Width="8" Height="8" Fill="#9EABB4" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="SchedulerServiceStatusText" Text="Checking…" Foreground="#E4E9EC" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                                    <TextBlock Text="WINDOWS TASK" Style="{StaticResource SignalLabelStyle}"/>
                                    <TextBlock Text="ForeSITE_Alerting_Scheduler" Foreground="#E4E9EC" TextWrapping="Wrap" Margin="0,6,0,18"/>
                                    <TextBlock Text="DAILY CHECK TIME" Style="{StaticResource SignalLabelStyle}"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="HourSelector" SelectedIndex="20" Style="{StaticResource InspectorComboStyle}"/>
                                        <TextBlock Grid.Column="1" Text=":" Foreground="#CFD7DD" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MinuteSelector" Grid.Column="2" SelectedIndex="0" Style="{StaticResource InspectorComboStyle}"/>
                                    </Grid>
                                    <TextBlock Text="The task runs while this Windows user is signed in."
                                               Foreground="#9EABB4" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <Button x:Name="BtnStart" Content="START SERVICE" Style="{StaticResource HeaderButtonStyle}"
                                            Click="SchedulerStart_Click"/>
                                    <Button x:Name="BtnEnd" Content="STOP SERVICE" Style="{StaticResource InspectorButtonStyle}"
                                            Padding="14,9" Margin="0,8,0,0" Click="SchedulerEnd_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scheduled report registry and bulk editor -->
                        <Border Grid.Column="2" Background="#182127" BorderBrush="#3A444C" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="18,17,18,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Scheduled reports" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                        <TextBlock Text="Check one or more tasks to update delivery settings or remove them. Table fields can be edited directly."
                                                   Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="10,7" VerticalAlignment="Top">
                                        <TextBlock x:Name="SchedulerSelectionSummary" Text="0 SELECTED" Style="{StaticResource SignalLabelStyle}"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="18,0">
                                <DataGrid x:Name="SchedulerTable" Margin="0"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="FullRow"
                                          Background="#20282E" Foreground="#E4E9EC" BorderBrush="#3A444C"
                                          RowBackground="#20282E" AlternatingRowBackground="#1C252B"
                                          HorizontalGridLinesBrush="#3A444C" VerticalGridLinesBrush="#3A444C"
                                          RowStyle="{StaticResource SchedulerRowStyle}"
                                          CellStyle="{StaticResource SchedulerCellStyle}"
                                          ColumnHeaderStyle="{StaticResource DataSourceColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="SELECT" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="SchedulerSelectCheckBox_Click"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ID" Width="52" Binding="{Binding Id}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="DELIVERY" Width="100" Binding="{Binding DeliveryMethod}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="RECIPIENTS" Width="1.25*" Binding="{Binding Recipients}"/>
                                        <DataGridTextColumn Header="REPORT FILE" Width="1.8*" Binding="{Binding AttachmentPath}"/>
                                        <DataGridTextColumn Header="START DATE" Width="112" Binding="{Binding StartDate}"/>
                                        <DataGridTextColumn Header="FREQUENCY" Width="100" Binding="{Binding Freq}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="SchedulerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="420" Visibility="Collapsed">
                                    <TextBlock Text="No scheduled reports" Foreground="#F1F4F6" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Open Report Builder, configure a report, then choose Schedule to add it here."
                                               Foreground="#9EABB4" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Margin="18" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="DELIVERY METHOD" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <ComboBox x:Name="DeliveryMethodSelector" SelectedIndex="0" Style="{StaticResource InspectorComboStyle}"
                                                      SelectionChanged="DeliveryMethodSelector_SelectionChanged"
                                                      ToolTip="Apply this delivery method to checked tasks">
                                                <ComboBoxItem Content="Email"/>
                                                <ComboBoxItem Content="Notification"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="RecipientEmailsLabel" Text="RECIPIENT EMAILS · ONE PER LINE"
                                                       Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <TextBox x:Name="RecipientEmailsBox" AcceptsReturn="True" MinHeight="58" MaxHeight="90"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Style="{StaticResource InspectorTextBoxStyle}"
                                                     ToolTip="These addresses are applied to every checked task"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="16,21,0,0">
                                            <Button x:Name="SchedulerSaveButton" Content="SAVE SELECTED" Style="{StaticResource HeaderButtonStyle}"
                                                    IsEnabled="False" MinWidth="145" Click="SchedulerSave_Click"/>
                                            <Button x:Name="SchedulerDeleteButton" Content="DELETE SELECTED" Style="{StaticResource InspectorButtonStyle}"
                                                    IsEnabled="False" MinWidth="145" Padding="14,9" Margin="0,8,0,0" Click="SchedulerDelete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <!-- Reports Grid -->
                <Grid x:Name="ReportsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <!-- Five fixed workflow cells: the split-flap board translated into report state. -->
                    <Border Grid.Row="0" Background="#182127" BorderBrush="#3A444C" BorderThickness="0,0,0,1">
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#3A444C" BorderThickness="1" Padding="12,8">
                                <StackPanel><TextBlock Text="1  DATA" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" FontSize="14"/><TextBlock Text="Choose or verify source" Foreground="#9EABB4" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#3A444C" BorderThickness="0,1,1,1" Padding="12,8">
                                <StackPanel><TextBlock Text="2  PERIOD" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" FontSize="14"/><TextBlock Text="Set date and frequency" Foreground="#9EABB4" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#3A444C" BorderThickness="0,1,1,1" Padding="12,8">
                                <StackPanel><TextBlock Text="3  MODEL" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" FontSize="14"/><TextBlock Text="Choose and configure" Foreground="#9EABB4" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#27333B" BorderBrush="#F2A900" BorderThickness="0,0,0,2" Padding="12,8">
                                <StackPanel><TextBlock Text="4  VISUAL" Style="{StaticResource SignalLabelStyle}" Foreground="#F2A900" FontSize="14"/><TextBlock Text="Add report content" Foreground="#F2A900" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" BorderBrush="#3A444C" BorderThickness="1" Padding="12,8">
                                <StackPanel><TextBlock Text="5  DELIVERY" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" FontSize="14"/><TextBlock Text="Not scheduled" Foreground="#9EABB4" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="SchedulingButton" Content="Schedule" Foreground="#CFD7DD" Background="Transparent" BorderBrush="#596873" Padding="13,8" Margin="0,0,8,0" Click="SchedulingButton_Click"/>
                                <Button x:Name="SaveButton" Content="Export PDF" Foreground="#CFD7DD" Background="Transparent" BorderBrush="#596873" Padding="13,8" Margin="0,0,8,0" Click="SaveButton_Click"/>
                                <Button x:Name="AddPlotButton" Content="▶  RUN REPORT" Style="{StaticResource HeaderButtonStyle}" Click="AddPlotButton_ClickAsync"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="326"/>
                        </Grid.ColumnDefinitions>

                        <!-- The builder is the view: a document surface, never a separate preview mode. -->
                        <Border Grid.Column="0" Margin="16" Background="#2B353C" BorderBrush="#46535D" BorderThickness="1" CornerRadius="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Background="#182127" LastChildFill="False">
                                    <TextBlock Text="LIVE REPORT CANVAS" Style="{StaticResource SignalLabelStyle}" Foreground="#F1F4F6" VerticalAlignment="Center" Margin="14,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="FIT PAGE   ·   100%" Style="{StaticResource SignalLabelStyle}" VerticalAlignment="Center" Margin="0,0,14,0" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
                                    <Border Width="840" MinHeight="720" Background="#F7F8F6" BorderBrush="#B9C1C6" BorderThickness="1" Padding="26" HorizontalAlignment="Center">
                                        <Canvas x:Name="DrawingCanvas" MinHeight="668" Background="#F7F8F6"/>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Contextual report inspector -->
                        <Border Grid.Column="1" Background="#151D23" BorderBrush="#3A444C" BorderThickness="1,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,16"
                                            TextElement.Foreground="#CFD7DD">
                                    <StackPanel.Resources>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource InspectorComboStyle}"/>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource InspectorTextBoxStyle}"/>
                                        <Style TargetType="DatePicker" BasedOn="{StaticResource InspectorDateStyle}"/>
                                        <Style TargetType="Button" BasedOn="{StaticResource InspectorButtonStyle}"/>
                                    </StackPanel.Resources>
                                    <TextBlock Text="REPORT INSPECTOR" Style="{StaticResource SignalLabelStyle}" Foreground="#F2A900" FontSize="13"/>
                                    <TextBlock Text="Analysis &amp; visualization" Style="{StaticResource PanelHeadingStyle}" Margin="0,4,0,18"/>

                                    <TextBlock Text="DATA SOURCE" Style="{StaticResource SignalLabelStyle}"/>
                                    <ComboBox x:Name="DataSourceSelector" SelectedIndex="0" DisplayMemberPath="Name" ItemsSource="{Binding DataSources}" Margin="0,5,0,14"/>

                                    <TextBlock Text="MONITORING MODEL" Style="{StaticResource SignalLabelStyle}"/>
                                    <ComboBox x:Name="ModelSelector" DisplayMemberPath="Name" SelectedIndex="4" SelectionChanged="ModelSelector_SelectionChanged" Margin="0,5,0,14"/>

                                    <StackPanel x:Name="YearBackPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                        <TextBlock Text="HISTORY (YEARS)" Style="{StaticResource SignalLabelStyle}"/>
                                        <ComboBox x:Name="YearBackSelector" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="1"/></ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="BodaPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                        <TextBlock Text="SAMPLED VECTORS" Style="{StaticResource SignalLabelStyle}"/><TextBox x:Name="TxtMcMunu" Text="100" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="EarsC1Panel" Visibility="Collapsed" Margin="0,0,0,14">
                                        <TextBlock Text="BASELINE (DAYS)" Style="{StaticResource SignalLabelStyle}"/><TextBox x:Name="TxtBaseline" Text="7" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="TIME PERIOD" Style="{StaticResource SignalLabelStyle}"/>
                                    <Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <DatePicker x:Name="BeginDatePicker" Grid.Column="0" ToolTip="Begin date"/>
                                        <ComboBox x:Name="FreqSelector" Grid.Column="2" SelectedIndex="0" ToolTip="Frequency"><ComboBoxItem Content="By Week"/><ComboBoxItem Content="By Month"/><ComboBoxItem Content="By Day"/></ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="TrainSplitCheckBox" Content="Use train split ratio" IsChecked="True" Checked="TrainSplitCheckBox_Checked" Unchecked="TrainSplitCheckBox_Unchecked" Foreground="#CFD7DD"/>
                                    <TextBox x:Name="TrainSplitRatioInput" Margin="0,7,0,10" ToolTip="Train split ratio"/>
                                    <StackPanel x:Name="DatePickersPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                        <TextBlock Text="TRAIN END DATE" Style="{StaticResource SignalLabelStyle}"/><DatePicker x:Name="TrainEndDatePicker" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,5">
                                        <TextBlock Text="MAXIMUM THRESHOLD" Style="{StaticResource SignalLabelStyle}" VerticalAlignment="Center"/>
                                        <Button x:Name="ThresholdBacktestHelpButton" Content="?" Width="22" Height="22" Margin="8,0,0,0" Padding="0" Background="#F2A900" Foreground="#11171C" ToolTip="Run CDC threshold backtest summary" Click="ThresholdBacktestHelpButton_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="ThresholdInput" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="AbnormalReportFlag" Content="Only deliver abnormal reports" IsChecked="True" Foreground="#CFD7DD" Margin="0,0,0,18"/>

                                    <Separator Background="#3A444C" Margin="0,0,0,16"/>
                                    <TextBlock Text="REPORT CONTENT" Style="{StaticResource SignalLabelStyle}"/>
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <Button x:Name="AddTitleButton" Content="Title" Margin="0,0,6,0" Padding="8" Click="AddTitleButton_Click"/>
                                        <Button x:Name="AddCommentButton" Content="Text" Margin="0,0,6,0" Padding="8" Click="AddCommentButton_Click"/>
                                        <Button Content="Chart" Padding="8" Click="AddPlotButton_ClickAsync"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#11171C" BorderBrush="#3A444C" BorderThickness="0,1,0,0">
                        <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#F2A900" Width="8" Height="8"/><TextBlock Text="  DRAFT REPORT" Style="{StaticResource SignalLabelStyle}" Foreground="#F2A900"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="COMPLETE CONFIGURATION, THEN RUN REPORT" Style="{StaticResource SignalLabelStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="LOCAL ANALYSIS SERVICE" Style="{StaticResource SignalLabelStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Data Source Grid -->
                <Grid x:Name="DataSourceGrid" Visibility="Collapsed">
                    <Border Background="#182127" BorderBrush="#3A444C" BorderThickness="1" Margin="16">
                        <TabControl x:Name="DataSourceTabs" Background="#182127" BorderThickness="0" Foreground="#E4E9EC">
                            <TabItem x:Name="DataSourceListTab" Header="DATA SOURCES">
                                <Grid Margin="22">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Connected data sources" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                            <TextBlock Text="Manage the API and CSV inputs available to reports and analysis notebooks."
                                                       Foreground="#9EABB4" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="AddDataSourceButton" Grid.Column="1" Content="ADD DATA SOURCE"
                                                Style="{StaticResource HeaderButtonStyle}" Click="AddDataSourceButton_Click"/>
                                    </Grid>
                                    <DataGrid x:Name="DataSourceTable" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                              CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              Margin="0,20,0,16" MinHeight="260" HeadersVisibility="Column"
                                              Background="#20282E" Foreground="#E4E9EC" BorderBrush="#3A444C"
                                              RowBackground="#20282E" AlternatingRowBackground="#1C252B"
                                              HorizontalGridLinesBrush="#3A444C" VerticalGridLinesBrush="#3A444C"
                                              RowStyle="{StaticResource SchedulerRowStyle}"
                                              CellStyle="{StaticResource SchedulerCellStyle}"
                                              ColumnHeaderStyle="{StaticResource DataSourceColumnHeaderStyle}"
                                              SelectionChanged="DataSourceTable_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.2*"/>
                                            <DataGridTextColumn Header="DATA LOCATION" Binding="{Binding DataURL}" Width="2*"/>
                                            <DataGridTextColumn Header="RESOURCE" Binding="{Binding ResourceURL}" Width="1.4*"/>
                                            <DataGridTextColumn Header="TOKEN" Binding="{Binding AppTokenMasked, Mode=OneWay}" IsReadOnly="True" Width="1*"/>
                                            <DataGridCheckBoxColumn Header="LIVE" Binding="{Binding IsRealtime}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="Select a row to remove a data source. Existing reports are not changed."
                                                   Foreground="#9EABB4" VerticalAlignment="Center"/>
                                        <Button x:Name="DeleteDataSourceButton" Content="DELETE SELECTED" HorizontalAlignment="Right"
                                                Style="{StaticResource InspectorButtonStyle}" Padding="13,8" IsEnabled="False"
                                                Click="DeleteDataSourceButton_Click"/>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="NewDataSourceTab" Header="NEW DATA SOURCE">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="22" MaxWidth="900" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Add a data source" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                            <TextBlock Text="Give the source a recognizable name, then choose whether ForeSITE should connect to an API or read a local CSV file."
                                                       Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="720"/>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="520"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SOURCE NAME" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                <TextBox x:Name="DataSourceNameInput" Style="{StaticResource DataSourceFieldStyle}"
                                                         ToolTip="A unique name shown throughout ForeSITE"/>
                                                <TextBlock Text="Use a short, distinct name such as Weekly respiratory visits."
                                                           Foreground="#9EABB4" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SOURCE TYPE" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                <StackPanel Orientation="Horizontal" Height="36" VerticalAlignment="Center">
                                                    <RadioButton x:Name="RealtimeRadio" Content="Live API" IsChecked="True" GroupName="DataSourceType"
                                                                 Foreground="#E4E9EC" Margin="0,0,24,0" Checked="DataSourceType_Checked"/>
                                                    <RadioButton x:Name="StaticRadio" Content="Local CSV file" GroupName="DataSourceType"
                                                                 Foreground="#E4E9EC" Checked="DataSourceType_Checked"/>
                                                </StackPanel>
                                                <TextBlock Text="API sources refresh from a remote endpoint; CSV sources use a file on this computer."
                                                           Foreground="#9EABB4" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="2" Margin="0,24,0,0" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="18">
                                            <Grid>
                                                <StackPanel x:Name="RealtimeFieldsPanel">
                                                    <TextBlock Text="API connection" Style="{StaticResource PanelHeadingStyle}" Margin="0,0,0,16"/>
                                                    <TextBlock Text="DATA URL" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                    <TextBox x:Name="DataUrlInput" Style="{StaticResource DataSourceFieldStyle}" Margin="0,0,0,14"
                                                             ToolTip="The API endpoint used to retrieve data"/>
                                                    <TextBlock Text="RESOURCE URL OR DATASET ID" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                    <TextBox x:Name="ResourceUrlInput" Style="{StaticResource DataSourceFieldStyle}" Margin="0,0,0,14"
                                                             ToolTip="The resource identifier required by the API"/>
                                                    <TextBlock Text="APP TOKEN" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                    <PasswordBox x:Name="AppTokenInput" MinHeight="36" Padding="8,6" VerticalContentAlignment="Center"
                                                                 Foreground="#E4E9EC" Background="#202A31" BorderBrush="#53616B"
                                                                 ToolTip="Stored securely and never displayed in the data source list"/>
                                                </StackPanel>
                                                <StackPanel x:Name="StaticFieldsPanel" Visibility="Collapsed">
                                                    <TextBlock Text="CSV file" Style="{StaticResource PanelHeadingStyle}" Margin="0,0,0,6"/>
                                                    <TextBlock Text="Choose a comma-separated values file from this computer. The file must remain at this location for future report runs."
                                                               Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                                    <TextBlock Text="FILE LOCATION" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SelectedFilePathBox" Style="{StaticResource DataSourceFieldStyle}" IsReadOnly="True"
                                                                 Text="No file selected" Foreground="#9EABB4"/>
                                                        <Button Grid.Column="1" Content="BROWSE…" Margin="10,0,0,0" Padding="14,8"
                                                                Style="{StaticResource InspectorButtonStyle}" Click="BrowseDataSourceFile_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="3" Margin="0,20,0,4">
                                            <TextBlock x:Name="DataSourceFormStatus" Foreground="#9EABB4" VerticalAlignment="Center"
                                                       Text="All fields are required for API sources."/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="CANCEL" Style="{StaticResource InspectorButtonStyle}" Padding="14,9" Margin="0,0,8,0"
                                                        Click="CancelDataSourceButton_Click"/>
                                                <Button x:Name="SaveDataSourceButton" Content="SAVE DATA SOURCE" Style="{StaticResource HeaderButtonStyle}"
                                                        Click="SaveDataSourceButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

                <!--Model Management Grid-->
                <Grid x:Name="ModelGrid" Visibility="Collapsed">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Algorithm catalog -->
                        <Border Grid.Column="0" Background="#182127" BorderBrush="#3A444C" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="18,17,18,14">
                                    <TextBlock Text="Algorithm catalog" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                    <TextBlock Text="Choose a surveillance method to inspect its implementation and parameters."
                                               Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="lstModel" Grid.Row="1" Margin="8,0" Background="Transparent" BorderThickness="0"
                                         Foreground="#E4E9EC" SelectionChanged="lstModel_SelectionChanged"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#E4E9EC"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                                BorderBrush="#3A444C" BorderThickness="1" Padding="12,10">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#202A31"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#27333B"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#F2A900"/>
                                                                <Setter Property="Foreground" Value="#F1F4F6"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFD36A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#9EABB4" FontSize="11"/>
                                                    <TextBlock Text=" · " Foreground="#596873" FontSize="11"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="#9EABB4" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" BorderBrush="#3A444C" BorderThickness="0,1,0,0" Padding="18,12">
                                    <TextBlock Text="Algorithms are available to Report Builder and scheduled reports."
                                               Foreground="#9EABB4" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Algorithm dossier -->
                        <Border Grid.Column="2" Background="#182127" BorderBrush="#3A444C" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="20,17,20,15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Algorithm details" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                        <TextBlock Text="Review the selected method and the parameter defaults used when reports are configured."
                                                   Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="10,7" VerticalAlignment="Top">
                                        <TextBlock Text="REFERENCE CONFIGURATION" Style="{StaticResource SignalLabelStyle}"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Margin="20,0,20,16" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="FULL NAME" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <TextBox x:Name="txtFullModelName" Style="{StaticResource DataSourceFieldStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SHORT NAME" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <TextBox x:Name="txtModelName" Style="{StaticResource DataSourceFieldStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="RUNTIME" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <TextBox x:Name="cmbModelType" Style="{StaticResource DataSourceFieldStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,16,0,0">
                                            <TextBlock Text="DESCRIPTION" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                            <TextBox x:Name="txtModelDescription" Style="{StaticResource DataSourceFieldStyle}" IsReadOnly="True"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" MaxHeight="96"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="20,0,20,20">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Parameters" Style="{StaticResource PanelHeadingStyle}"/>
                                            <TextBlock Text="Names, user-facing labels, value types, and defaults for this algorithm."
                                                       Foreground="#9EABB4" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Properties.Count, ElementName=lstModel, StringFormat='{}{0} PARAMETERS'}"
                                                   Style="{StaticResource SignalLabelStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="dgProperties" Margin="0,12,0,0" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                              Background="#20282E" Foreground="#E4E9EC" BorderBrush="#3A444C"
                                              RowBackground="#20282E" AlternatingRowBackground="#1C252B"
                                              HorizontalGridLinesBrush="#3A444C" VerticalGridLinesBrush="#3A444C"
                                              RowStyle="{StaticResource SchedulerRowStyle}" CellStyle="{StaticResource SchedulerCellStyle}"
                                              ColumnHeaderStyle="{StaticResource DataSourceColumnHeaderStyle}"
                                              CellEditEnding="dgProperties_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PARAMETER" Binding="{Binding Name}" Width="1.1*"/>
                                            <DataGridTextColumn Header="LABEL" Binding="{Binding Title}" Width="1.5*"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="0.7*"/>
                                            <DataGridTextColumn Header="DEFAULT VALUE" Binding="{Binding DefaultValue}" Width="1*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <!-- Setup Grid -->
                <Grid x:Name="SetupGrid" Visibility="Collapsed">
                    <Border Margin="16" Background="#182127" BorderBrush="#3A444C" BorderThickness="1">
                        <TabControl Background="Transparent" BorderThickness="0" Foreground="#E4E9EC"
                                    ItemContainerStyle="{StaticResource SettingsTabItemStyle}">
                            <TabItem Header="SYSTEM CONFIGURATION">
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="System configuration" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                            <TextBlock Text="Edit the local analysis service parameters stored in config.json."
                                                       Foreground="#9EABB4" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="REFRESH" Style="{StaticResource InspectorButtonStyle}" Padding="14,9" Margin="0,0,8,0"
                                                    Click="RefreshSystemConfig_Click"/>
                                            <Button Content="SAVE CONFIGURATION" Style="{StaticResource HeaderButtonStyle}"
                                                    Click="SaveSystemConfig_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,18,0,12" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="CONFIG FILE" Style="{StaticResource SignalLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Current user · config.json · SMTP password is supplied through FORESITE_SMTP_PASSWORD"
                                                       Foreground="#CFD7DD" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <DataGrid x:Name="SystemConfigTable" Grid.Row="2"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              IsReadOnly="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                              SelectionMode="Single" SelectionUnit="Cell"
                                              Background="#20282E" Foreground="#E4E9EC" BorderBrush="#3A444C"
                                              RowBackground="#20282E" AlternatingRowBackground="#1C252B"
                                              HorizontalGridLinesBrush="#3A444C" VerticalGridLinesBrush="#3A444C"
                                              RowStyle="{StaticResource SchedulerRowStyle}" CellStyle="{StaticResource SchedulerCellStyle}"
                                              ColumnHeaderStyle="{StaticResource DataSourceColumnHeaderStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PARAMETER" Binding="{Binding Key}" Width="280" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="VALUE" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="3" Margin="0,12,0,0" Background="#151D23" BorderBrush="#3A444C" BorderThickness="1" Padding="12,9">
                                        <TextBlock x:Name="SystemConfigStatusText" Foreground="#9EABB4" Text="Changes are saved locally for the current Windows user."
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="AI ASSISTANT">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="20" MaxWidth="820" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AI assistant connection" Style="{StaticResource PanelHeadingStyle}" FontSize="18"/>
                                            <TextBlock Text="Connect ForeSITE to an OpenAI-compatible language model service used by the AI Assistant."
                                                       Foreground="#9EABB4" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="700"/>
                                        </StackPanel>

                                        <Border Grid.Row="1" Margin="0,22,0,0" Background="#20282E" BorderBrush="#3A444C" BorderThickness="1" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="BASE URL" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                <TextBox x:Name="LlmBaseUrlBox" Style="{StaticResource DataSourceFieldStyle}" Margin="0,0,0,7"
                                                         ToolTip="The base URL for the OpenAI-compatible API"/>
                                                <TextBlock Text="Example: http://localhost:11434/v1 or your organization’s approved endpoint."
                                                           Foreground="#9EABB4" FontSize="12" Margin="0,0,0,18"/>

                                                <TextBlock Text="API KEY" Style="{StaticResource DataSourceFieldLabelStyle}"/>
                                                <PasswordBox x:Name="LlmApiKeyBox" MinHeight="36" Padding="8,6" VerticalContentAlignment="Center"
                                                             Foreground="#E4E9EC" Background="#202A31" BorderBrush="#53616B"
                                                             ToolTip="Stored in protected form in the current user's local application data"/>
                                                <TextBlock Text="The key is protected before it is written to local configuration."
                                                           Foreground="#9EABB4" FontSize="12" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="2" Margin="0,18,0,0">
                                            <TextBlock x:Name="LlmConfigStatusText" Foreground="#9EABB4" VerticalAlignment="Center"
                                                       Text="Enter the service URL and API key, then save the connection." TextWrapping="Wrap"/>
                                            <Button Content="SAVE AI CONNECTION" HorizontalAlignment="Right" Style="{StaticResource HeaderButtonStyle}"
                                                    Click="SaveLlmConfig_Click"/>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>


            </Grid>
        </Grid>


    </Grid>
</UserControl>
